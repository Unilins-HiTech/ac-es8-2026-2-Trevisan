# Copie este arquivo para ".env" e preencha com os dados do seu projeto Supabase
# (Project Settings → API Keys / Data API). NUNCA faça commit do .env!

SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...

# Endereços que podem chamar a API (separados por vírgula). Vazio = qualquer um.
CORS_ORIGIN=https://pokedex-app-trevisan.onrender.com,http://localhost:5510

PORT=3000
